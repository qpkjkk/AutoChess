<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="兵的升变"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/promoQueen"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:padding="6dp"
            android:contentDescription="后" />

        <ImageView
            android:id="@+id/promoRook"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:padding="6dp"
            android:contentDescription="车" />

        <ImageView
            android:id="@+id/promoBishop"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:padding="6dp"
            android:contentDescription="象" />

        <ImageView
            android:id="@+id/promoKnight"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:padding="6dp"
            android:contentDescription="马" />
    </LinearLayout>
</LinearLayout>
